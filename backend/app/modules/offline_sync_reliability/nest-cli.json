{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "translations/catalogs/*.json",
        "outDir": "dist"
      },
      {
        "include": "product-tour/tours/*.json",
        "outDir": "dist"
      }
    ]
  }
}
