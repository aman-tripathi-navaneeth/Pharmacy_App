# PostgreSQL (any managed Postgres works: Supabase, Neon, RDS, …)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/medical_store
DATABASE_POOL_MAX=10
# true for managed databases that require TLS
DATABASE_SSL=false
# Dev/test convenience; deployments run `npm run db:migrate` as a release step
DB_MIGRATE_ON_BOOT=false
# Must match the shared Authentication module's signing secret
JWT_SECRET=change-me
PORT=3000
THROTTLE_LIMIT_PER_MIN=120
# Browser origins allowed to call the API (comma-separated). Leave empty for native-only.
CORS_ORIGINS=
# Dev only: simulate module health, e.g. payments:DEGRADED,notifications:UNAVAILABLE
DEV_FAKE_HEALTH=
